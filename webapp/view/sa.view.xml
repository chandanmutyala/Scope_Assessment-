<mvc:View
    controllerName="scopeassessment.controller.sa"
	xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
	xmlns:rowmodes="sap.ui.table.rowmodes"
	xmlns:tnt="sap.tnt"
    height="100%"
	xmlns:mdc="sap/ui/mdc"
	xmlns:core="sap.ui.core"
>
	<m:Page
        showHeader="false"
        enableScrolling="false"
        class="sapUiContentPadding"
    >
		<tnt:ToolHeader id="shellLikeToolHeaderOnlyMandatoryControls">
			<m:Title
                text="Scope Assessment"
                wrapping="false"
            >
				<m:layoutData>
					<m:OverflowToolbarLayoutData priority="Disappear" />
				</m:layoutData>
			</m:Title>
		</tnt:ToolHeader>
		<m:content>
			<!-- <m:Label text="Select Country" labelFor="select1"/><m:Select id="select1" width="100%" items="{selectionmodel>/selectionitems}" selectedKey="MultiToggle" change="onSelectionModeChange"><c:Item key="{selectionmodel>key}" text="{selectionmodel>text}"/></m:Select> -->
			<m:Panel >
				<m:MultiInput
    id="scopeIdMultiInput"
    showValueHelp="true"
    valueHelpRequest=".onValueHelpRequest"
    placeholder="Select Scope IDs"
    width="300px"
    tokenUpdate=".onTokenChange"></m:MultiInput>
				<!-- <m:MultiComboBox
            id="descriptionComboBox"
                selectionChange="onComboBoxSelectionChange"
                placeholder="Select Scope Description"
                width="300px"
            items="{
                path: '/ScopeItems',
                sorter: { path: 'Description' }
            }"><c:Item key="{Description}" text="{Description}"/></m:MultiComboBox> -->
				<m:MultiComboBox
            id="descriptionComboBox"
                selectionChange="onComboBoxSelectionChange"
                placeholder="Select Scope Description"
                width="300px"
            items="{
                        path: '/getUniqueValues(column=\'Description\')'
                    }">
					<c:Item key="{keey}" text="{text}"/>
				</m:MultiComboBox>
				<m:MultiComboBox
            id="lobComboBox"
                selectionChange="onComboBoxSelectionChange"
                placeholder="Select LOB"
                width="300px"
            items="{
                path: '/getUniqueValues(column=\'LOB\')'
            }">
					<c:Item key="{keey}" text="{text}"/>
				</m:MultiComboBox>
				<m:MultiComboBox
            id="businessAreaComboBox"
                selectionChange="onComboBoxSelectionChange"
                placeholder="Select BusinessArea"
                width="300px"
            items="{
                path: '/getUniqueValues(column=\'BusinessArea\')'
            }">
					<c:Item key="{keey}" text="{text}"/>
				</m:MultiComboBox>
				<!-- <m:MultiComboBox
            id="statusComboBox"
                selectionChange="onComboBoxSelectionChange"
                placeholder="Select Status"
                width="300px"
            items="{
                path: '/getUniqueValues(column=\'Status\')'
            }"><c:Item key="{keey}" text="{text}"/></m:MultiComboBox> -->
				<m:MultiComboBox
            id="countryComboBox"
                selectionChange="onCountrySelectionChange"
                placeholder="Select Countries"
                width="300px"
            items="{
                path: '/countries'
            }">
					<c:Item key="{code}" text="{name}" />
				</m:MultiComboBox>
				<!-- <m:MultiComboBox
                id="countryComboBox"
                selectionChange="onCountrySelectionChange"
                placeholder="Select Countries"
                width="300px"
            /> -->
			</m:Panel>
			<m:HBox
    class="sapUiSmallMargin"
    justifyContent="End" 
    alignItems="Start">
				<!-- Legend Container -->
				<m:VBox>
					<m:HBox class="sapUiSmallMarginEnd">
						<m:HBox class="itemContainer">
							<core:Icon
                src="sap-icon://accept"
                width="1.5rem"
                height="1.5rem"
                color="green"
                class="sapUiSmallMarginEnd"/>
							<m:Text text="Released"
            tooltip="The identified scope item is available for deployment." />
						</m:HBox>
						<m:HBox class="itemContainer">
							<core:Icon
                src="sap-icon://decline"
                width="1.5rem"
                height="1.5rem"
                color="red"
                class="sapUiSmallMarginEnd"/>
							<m:Text text="No"
             tooltip="The scope item is currently not planned for the next release." />
						</m:HBox>
						<m:HBox class="itemContainer">
							<core:Icon
                src="sap-icon://legend"
                width="1.5rem"
                height="1.5rem"
                color="yellow"
                class="sapUiSmallMarginEnd"/>
							<m:Text text="Planned"
            tooltip="Scope item is currently planned for the next release. Disclaimer, it is subject to change." />
						</m:HBox>
						<m:HBox class="itemContainer">
							<core:Icon
                src="sap-icon://cancel"
                width="1.5rem"
                height="1.5rem"
                color="gray"
                class="sapUiSmallMarginEnd"/>
							<m:Text text="Not Applicable"
            tooltip="The identified scope item is not applicable to be deployed in the selected country." />
						</m:HBox>
					</m:HBox>
				</m:VBox>
			</m:HBox>
			<Table
                class="tableclass"
                id="scopeItemsTable"
                rows="{
                path: '/ScopeItems',
                sorter: { path: 'ScopeItemID' }
            }"
                selectionMode="MultiToggle"
                ariaLabelledBy="title"
                rowActionCount="20"
            >
				<extension>
					<m:OverflowToolbar style="Clear">
						<m:Title
                            id="title"
                            text="Scope Items"
                        />
					</m:OverflowToolbar>
				</extension>
				<rowMode>
					<rowmodes:Fixed rowCount="20" />
				</rowMode>
				<columns>
					<Column width="7rem">
						<m:Label text="Scope Item ID" />
						<template>
							<m:Text
                                text="{ScopeItemID}"
                                wrapping="false"
                            />
						</template>
					</Column>
					<Column width="30rem">
						<m:Label text="Description" />
						<template>
							<m:HBox>
								<m:Text
                                text="{Description}"
                                wrapping="false"
                            />
							</m:HBox>
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Line of Business" />
						<template>
							<m:HBox>
								<m:Text
                                text="{LOB}"
                                wrapping="false"
                                textAlign="Center"
                            />
							</m:HBox>
						</template>
					</Column>
					<Column width="16rem">
						<m:Label text="Business Area" />
